# PORT where the server runs
PORT=5000

# Database Connection String (Use your own Atlas URI or local localhost)
# Example Local: mongodb://localhost:27017/secure-submission-system
# Example Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname
MONGO_URI=mongodb://localhost:27017/secure-submission-system

# Secret Key for signing JWT tokens (Make this long and random in production)
JWT_SECRET=secure_academic_submission_secret_key_2026

# Frontend URL (For CORS - allowing the frontend to talk to backend)
CLIENT_URL=http://localhost:5173